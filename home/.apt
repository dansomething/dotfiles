#!/usr/bin/env bash
set -eou pipefail

echo "Installing APT packages..."
echo

# Install additional command-line tools using Apt.
sudo apt-get update && sudo apt-get install -y --no-install-recommends \
  build-essential \
  cmake \
  gnome-tweaks \
  urlview \
  xclip \
  sudo apt-get autoremove &&
  echo

# Gnome Terminal Jellybeans profile
echo "Installing gnome terminal config..."
hash dconf >/dev/null 2>&1 && {
  dconf load /org/gnome/terminal/legacy/profiles:/ <~/.gnome/gnome-terminal-profiles.dconf
}
echo

echo "Installing keyd"
hash keyd >/dev/null 2>&1 && {
  if [[ ! -d ~/co/keyd ]]; then
    mkdir -p ~/co
    git clone https://github.com/rvaiya/keyd ~/co/keyd
  fi
  pushd ~/co/keyd > /dev/null 2>&1
  make && sudo make install
  popd > /dev/null 2>&1

  sudo systemctl enable --now keyd
  sudo tee /etc/keyd/default.conf << 'EOF' > /dev/null
[ids]

*

[main]

# Maps capslock to escape when pressed and control when held.
capslock = overload(control, esc)

# Remaps the escape key to capslock
#esc = capslock
EOF

  sudo keyd reload
}

echo "Linux packages installed."
